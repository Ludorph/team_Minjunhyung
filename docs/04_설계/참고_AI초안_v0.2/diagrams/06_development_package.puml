@startuml
title [개발 관점] 패키지 다이어그램 (프로젝트 골격 구조)
skinparam shadowing false
skinparam defaultFontName "Malgun Gothic"
skinparam packageStyle folder
skinparam nodesep 30
skinparam ranksep 45

package "frontend (React + Vite)" as FE {
  package pages
  package components
  package "api (axios 클라이언트)" as feapi
  pages ..> components
  pages ..> feapi
}

package "backend/app (FastAPI)" as BE {
  package "presentation\n(routers, schemas)" as pres
  package "business" as biz {
    package services
    package pipeline
    package analyzers
    package priority
    package response
    package state
    services ..> pipeline
    pipeline ..> analyzers
    pipeline ..> priority
    services ..> response
  }
  package "persistence\n(models, repositories)" as pers
  package "infra\n(ai_client, config)" as infra
  pres ..> services
  services ..> pers
  services ..> state
  analyzers ..> infra
  response ..> infra
}

feapi ..> pres : REST/JSON
@enduml
